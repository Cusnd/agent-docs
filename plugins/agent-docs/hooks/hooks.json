{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/agent-docs.mjs\" hook user-prompt-submit",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/agent-docs.mjs\" hook user-prompt-submit",
            "timeout": 10,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/agent-docs.mjs\" hook subagent-start",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/agent-docs.mjs\" hook subagent-start",
            "timeout": 10,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/agent-docs.mjs\" hook stop",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/agent-docs.mjs\" hook stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
